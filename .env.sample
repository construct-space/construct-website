# Public site URL — used for canonical links, sitemap entries, and
# og-image absolute URLs. Falls back to https://lisaos.dev.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: override the Nitro listen port. Defaults to 3000 in dev,
# 80 inside the Docker container (set there via Dockerfile).
# NITRO_PORT=3000

# Added 2026-09-08 from the deployment's keys
DB_DRIVER=mysql
DB_HOST=mysql-db
DB_PORT=3306
DB_USER=root
DB_PASS=change-me
DB_NAME=construct
PORT=3000
APP_URL=https://construct.space
OAUTH_URL=https://accounts.construct.space
OAUTH_CLIENT_ID=construct_website
OAUTH_CLIENT_SECRET=change-me
OAUTH_REDIRECT_URI=https://construct.space/api/auth/callback
